# DOMCHAT Configuration
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
DEBUG=False

# AI Inference Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:1.5b
LOCAL_ONLY=True

# Optional Cloud API Keys (leave blank for local-only)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=4
HYBRID_ALPHA=0.5

# Storage Paths
STORAGE_DIR=./storage
