# DOMCHAT Environment Configuration
# Copy this file to .env and update with your values

# Required: Groq API Key (if using Groq as LLM provider)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom storage paths (uses defaults if not specified)
# CHROMA_DB_PATH=./storage/chroma_storage
# LLAMA_MODEL_PATH=./storage/models/your-model.gguf

# Optional: Logging level
# LOG_LEVEL=INFO