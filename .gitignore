# =========================
# DOMCHAT runtime storage
# =========================

# ChromaDB runtime data
storage/chroma/*

# SQLite runtime database
storage/db/*

# Uploaded files
storage/uploads/*

# Generated exports
storage/exports/*

# Keep empty storage folders in Git
!storage/chroma/.gitkeep
!storage/db/.gitkeep
!storage/uploads/.gitkeep
!storage/exports/.gitkeep

