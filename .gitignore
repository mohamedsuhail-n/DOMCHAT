# =========================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Python testing / tooling
.pytest_cache/
.coverage
coverage/
htmlcov/
.mypy_cache/
.ruff_cache/

# =========================
# Node / frontend
# =========================
node_modules/
frontend/node_modules/

